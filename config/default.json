{
  "blackboardDir": "~/.codex-moa/blackboard",
  "defaultCwd": ".",
  "defaultTimeoutMs": 900000,
  "maxConcurrentSeats": 3,
  "maxOutputChars": 24000,
  "commands": {
    "kimi": {
      "command": "kimi",
      "args": []
    },
    "zcode": {
      "command": "node",
      "args": [
        "/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs"
      ]
    },
    "dsh": {
      "command": "dsh",
      "args": []
    },
    "pi": {
      "command": "pi",
      "args": []
    },
    "claude": {
      "command": "claude",
      "args": []
    },
    "codex": {
      "command": "codex",
      "args": []
    }
  },
  "profiles": {
    "dsh": {
      "fast": "headless",
      "deep": "headless"
    }
  },
  "safety": {
    "externalAgentsEnabled": true,
    "allowWriteByDefault": false,
    "stripSecretEnv": true,
    "redactLogs": true
  },
  "zcode": {
    "desktopConfig": "~/.zcode/v2/config.json",
    "settingsPath": "~/.zcode/v2/setting.json",
    "cliConfig": "~/.zcode/cli/config.json",
    "provider": "",
    "headlessProvider": "",
    "headlessHome": "~/.codex-moa/zcode-home"
  },
  "pi": {
    "headlessHome": "~/.codex-moa/pi-home",
    "syncCcSwitchProviders": true,
    "providerAllowlist": [
      "cc-switch-kimi-for-coding",
      "cc-switch-zhipu-glm",
      "deepseek"
    ]
  },
  "claude": {
    "headlessHome": "~/.codex-moa/claude-homes"
  },
  "codex": {
    "headlessHome": "~/.codex-moa/codex-homes"
  },
  "cliLifecycle": {
    "policy": "detect-only",
    "upgradeOwner": "cc-switch-or-user",
    "autoUpgrade": false,
    "minimumVersions": {
      "pi": "0.85.1",
      "claude": "2.1.272",
      "codex": "0.154.0"
    },
    "packages": {
      "pi": "@earendil-works/pi-coding-agent",
      "claude": "@anthropic-ai/claude-code",
      "codex": "@openai/codex"
    }
  },
  "skills": {
    "searchRoots": [
      "~/.cc-switch/skills",
      "~/.pi/agent/skills"
    ],
    "allowedRoots": [
      "~/.cc-switch/skills",
      "~/.codex/skills",
      "~/.agents/skills",
      "~/.pi/agent/skills",
      "~/.codex/plugins"
    ]
  },
  "quota": {
    "snapshotPath": "~/.codex-moa/quota.json",
    "zaiRegion": "bigmodel-cn",
    "maxAgeMs": 300000,
    "refreshOnRun": true
  },
  "worktrees": {
    "cleanup": "never",
    "staleAfterHours": 168
  },
  "budgets": {
    "enforce": true,
    "maxTokens": null,
    "maxEstimatedUsd": null,
    "maxDurationMs": null,
    "maxContextUsed": null
  },
  "retention": {
    "enabled": true,
    "blackboard": {
      "maxAgeDays": 14,
      "maxTasks": 500
    },
    "jobs": {
      "maxAgeDays": 7,
      "maxJobs": 200
    },
    "worktrees": {
      "maxAgeDays": 7,
      "onlyClean": true
    },
    "costLedger": {
      "maxAgeDays": 180,
      "maxEntries": 50000
    },
    "auditMetrics": {
      "maxAgeDays": 365,
      "maxEntries": 100000
    },
    "failureMemory": {
      "maxAgeDays": 365,
      "maxEntries": 100000
    },
    "routingHistory": {
      "maxEntriesPerExperiment": 200
    }
  },
  "providerHealth": {
    "failureThreshold": 3,
    "baseOpenMs": 60000,
    "maxOpenMs": 3600000,
    "latencyWarningMs": 10000,
    "windowSize": 100
  },
  "failureMemory": {
    "transientWindowHours": 6,
    "transientThreshold": 2,
    "transientGuardHours": 1,
    "protocolGuardHours": 2,
    "deterministicGuardHours": 24
  }
}
